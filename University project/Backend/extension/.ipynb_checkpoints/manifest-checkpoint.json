{
  "manifest_version": 3,
  "name": "AI Text Simplifier",
  "version": "1.0",
  "description": "Simplify selected text or full web pages with AI.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8002/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}